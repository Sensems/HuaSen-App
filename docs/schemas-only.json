{
  "openapi": "3.0.0",
  "info": {
    "title": "花森笔记 API",
    "description": "微信公众号驱动的个人笔记系统。\n\n## 统一响应\n除 `/wechat/*` 外，成功响应均为：\n```json\n{ \"code\": 0, \"message\": \"ok\", \"data\": {} }\n```\n业务错误多为 HTTP 200，通过 `code` 区分（见错误码）。\n\n## 认证\n需登录接口点击 Authorize，填入 `accessToken`（按 UI 提示是否加 Bearer 前缀）。",
    "version": "1.0",
    "contact": {}
  },
  "components": {
    "schemas": {
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "业务错误码",
            "example": 10001
          },
          "message": {
            "type": "string",
            "description": "错误信息",
            "example": "请求参数校验失败"
          },
          "data": {
            "type": "object",
            "description": "错误时一般为 null",
            "example": null,
            "nullable": true,
            "additionalProperties": true
          },
          "details": {
            "type": "array",
            "description": "校验细节（可选）",
            "example": [
              "email must be an email"
            ],
            "nullable": true,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "ApiResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "description": "业务码，0 表示成功",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "提示信息",
            "example": "ok"
          },
          "data": {
            "type": "object",
            "description": "业务数据，无数据时为 null",
            "nullable": true,
            "example": null,
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "TokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "访问令牌（access_token，2 小时有效）",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌（refresh_token，7 天有效）",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "expiresIn": {
            "type": "number",
            "description": "access_token 过期时间（秒）",
            "example": 7200
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn"
        ]
      },
      "WechatCallbackDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "微信授权回调 code",
            "example": "081aB6tM0xj3bV1eYz2oM1tLqM0aB6tM"
          }
        },
        "required": [
          "code"
        ]
      },
      "EmailSendCodeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "接收验证码的邮箱",
            "example": "user@example.com"
          },
          "purpose": {
            "type": "string",
            "description": "验证码用途：register 注册 / reset_password 重置密码",
            "example": "register",
            "enum": [
              "register",
              "reset_password"
            ]
          }
        },
        "required": [
          "email",
          "purpose"
        ]
      },
      "EmailRegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "密码（≥8位，必须包含字母和数字）",
            "example": "Abc12345"
          },
          "code": {
            "type": "string",
            "description": "6位数字验证码",
            "example": "482931"
          }
        },
        "required": [
          "email",
          "password",
          "code"
        ]
      },
      "EmailResetPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "新密码（≥8位，必须包含字母和数字）",
            "example": "Abc12345"
          },
          "code": {
            "type": "string",
            "description": "6位数字验证码",
            "example": "482931"
          }
        },
        "required": [
          "email",
          "password",
          "code"
        ]
      },
      "EmailLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "邮箱",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "密码",
            "example": "Abc12345"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "刷新令牌（refresh_token）",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "登出是否成功",
            "example": true
          }
        },
        "required": [
          "success"
        ]
      },
      "UserProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "nickname": {
            "type": "object",
            "example": "花森",
            "nullable": true
          },
          "avatar": {
            "type": "object",
            "example": "https://cdn.example.com/a.png",
            "nullable": true
          },
          "email": {
            "type": "object",
            "example": "user@example.com",
            "nullable": true
          },
          "bindingCode": {
            "type": "object",
            "description": "6 位绑定码；可发到公众号完成绑定",
            "example": "ABC234",
            "nullable": true
          },
          "wxBound": {
            "type": "boolean",
            "description": "是否已绑定微信",
            "example": false
          }
        },
        "required": [
          "id",
          "nickname",
          "avatar",
          "email",
          "bindingCode",
          "wxBound"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "example": "花森",
            "description": "昵称"
          },
          "avatar": {
            "type": "string",
            "example": "https://cdn.example.com/a.png",
            "description": "头像 URL"
          }
        }
      },
      "BindUserResponseDto": {
        "type": "object",
        "properties": {
          "wxBound": {
            "type": "boolean",
            "example": true
          },
          "syncedDraftCount": {
            "type": "number",
            "description": "从空壳同步过来的草稿数",
            "example": 3
          },
          "overwritten": {
            "type": "boolean",
            "description": "是否覆盖了其他账号上的同 openid",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "绑定成功"
          }
        },
        "required": [
          "wxBound",
          "syncedDraftCount",
          "overwritten",
          "message"
        ]
      },
      "BindUserDto": {
        "type": "object",
        "properties": {
          "bindingCode": {
            "type": "string",
            "example": "ABC234",
            "description": "微信空壳下发的绑定码"
          }
        },
        "required": [
          "bindingCode"
        ]
      },
      "NoteBareDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "userId": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "categoryId": {
            "type": "object",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "nullable": true
          },
          "type": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "ARCHIVED"
            ],
            "example": "PUBLISHED"
          },
          "source": {
            "type": "string",
            "enum": [
              "WECHAT",
              "APP_CLIPBOARD",
              "APP_MANUAL"
            ],
            "example": "APP_MANUAL"
          },
          "title": {
            "type": "object",
            "example": "我的第一篇笔记",
            "nullable": true
          },
          "content": {
            "type": "object",
            "example": "这是笔记的正文内容...",
            "nullable": true
          },
          "rawContent": {
            "type": "object",
            "example": null,
            "nullable": true
          },
          "deletedAt": {
            "type": "object",
            "example": null,
            "nullable": true
          },
          "meta": {
            "type": "object",
            "description": "扩展元数据（如微信 wechat_msg_id）",
            "example": null,
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-07-15T10:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-07-15T10:00:00.000Z"
          },
          "pinnedAt": {
            "type": "object",
            "example": null,
            "nullable": true
          }
        },
        "required": [
          "id",
          "userId",
          "categoryId",
          "type",
          "source",
          "title",
          "content",
          "rawContent",
          "deletedAt",
          "meta",
          "createdAt",
          "updatedAt",
          "pinnedAt"
        ]
      },
      "NoteCategoryBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "name": {
            "type": "string",
            "example": "工作"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "NoteTagBriefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
          },
          "name": {
            "type": "string",
